# --- required ---
APP_TOKEN=change-me-long-random-string      # the mobile app sends this; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
GEMINI_API_KEY=
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=                           # new-style token (KGAT_...). Or use KAGGLE_KEY instead (legacy kaggle.json key)
HF_TOKEN=                                   # Hugging Face token with WRITE access
DATABASE_URL=                               # Render Postgres "Internal Database URL". Empty = local SQLite file

# --- optional ---
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash   # tried in order; first that exists wins
MAX_STEPS_PER_RUN=40
MAX_TOOL_ERRORS=6
MAX_CONCURRENT_TASKS=2
MAX_CONTEXT_CHARS=150000
GPU_WEEKLY_BUDGET_HOURS=20                  # agent-side safety cap (Kaggle's real quota is ~30h/week, visible only on kaggle.com)
WORKDIR=/tmp/agent
